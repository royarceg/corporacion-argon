# =====================================================
# CONFIGURACIÓN — Corporación Argon (backend)
# =====================================================

# --- Base de datos PostgreSQL ---
# El código usa DATABASE_URL (cadena de conexión completa), no variables sueltas.
DATABASE_URL=postgresql://usuario:password@host:puerto/basedatos

# --- Servidor ---
PORT=5000
NODE_ENV=development
# En producción (Railway): NODE_ENV=production

# --- JWT (tokens de sesión; se guardan en cookie httpOnly) ---
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Email (envío vía Resend, API HTTP — Railway bloquea SMTP) ---
# La API key de Resend (re_...). El código usa RESEND_API_KEY, con EMAIL_PASSWORD como fallback.
RESEND_API_KEY=re_tu_api_key_de_resend
EMAIL_PASSWORD=re_tu_api_key_de_resend
EMAIL_FROM=noreply@corporacionargon.com

# --- Cloudinary (imágenes y videos de productos) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- Frontend para CORS ---
# Una sola URL en FRONTEND_URL, o varias separadas por coma en FRONTEND_URLS.
FRONTEND_URL=http://localhost:3002
FRONTEND_URLS=https://corporacionargon.com,https://www.corporacionargon.com
